# Copy to .env for local development. On Railway, set these as service variables instead.

# Required. The server calls OpenRouter with this key; it is never sent to the browser.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional. Defaults to deepseek/deepseek-v4-flash.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional. one of: none | minimal | low | medium | high | xhigh | max
# Defaults to "none", which disables reasoning entirely — correct for DeepSeek and the
# cheapest option, since any other level bills reasoning tokens even when hidden.
# Only set this to "minimal" if you switch OPENROUTER_MODEL back to a GPT-5 or Grok model.
OPENROUTER_REASONING_EFFORT=none

# Optional. Sent to OpenRouter as the HTTP-Referer attribution header.
# Falls back to the incoming request's host when unset.
APP_URL=https://your-app.up.railway.app

# Optional. Railway injects its own PORT; this is only for local runs.
PORT=3000
